{
  "name": "virtue-agency-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:website": "npm --workspace=frontend/website run dev",
    "dev:admin": "npm --workspace=frontend/admin run dev",
    "seed": "npm --workspace=backend run seed",
    "build": "npm --workspaces run build"
  }
}
